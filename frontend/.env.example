# 🔐 Variables de entorno para el Frontend
# Copia este archivo como .env y completa los valores

# URL base de la API (usa el proxy de Vite para desarrollo)
VITE_API_URL=/api/v1

# URL de Supabase (reemplaza con tu proyecto)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Clave pública/anónima de Supabase (NO usar service_role key aquí)
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Tiempo de expiración del caché en segundos (opcional, default: 300)
# VITE_CACHE_TTL=300

# Mock API para desarrollo sin backend (true/false)
# VITE_MOCK_API=false
