# ============================================
# Configuración General del Sistema
# ============================================

# Puerto del API Gateway
GATEWAY_PORT=3000

# ============================================
# Supabase Database
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_HOST=db.your-project.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=inventory-system

# ============================================
# Encriptación
# ============================================
BCRYPT_SALT_ROUNDS=12
ENCRYPTION_KEY=your-32-character-encryption-key

# ============================================
# Servicio de Correos
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@inventorysystem.com
EMAIL_FROM_NAME="Sistema de Inventario"

# ============================================
# WhatsApp API
# ============================================
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_URL=https://graph.facebook.com/v17.0

# ============================================
# Microservicios - Puertos
# ============================================
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
PRODUCT_SERVICE_PORT=3003
CATEGORY_SERVICE_PORT=3004
INVENTORY_SERVICE_PORT=3005
PURCHASE_SERVICE_PORT=3006
SALE_SERVICE_PORT=3007
REPORT_SERVICE_PORT=3008
INVOICE_SERVICE_PORT=3009
CART_SERVICE_PORT=3010
CHECKOUT_SERVICE_PORT=3011
ECOMMERCE_SERVICE_PORT=3012
CATALOG_SERVICE_PORT=3013
EMAIL_SERVICE_PORT=3014
WHATSAPP_SERVICE_PORT=3015
NOTIFICATION_SERVICE_PORT=3016
AUDIT_SERVICE_PORT=3017
CONFIG_SERVICE_PORT=3018

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:5173
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ============================================
# Reportes
# ============================================
REPORT_UPLOAD_PATH=./reports
REPORT_MAX_FILE_SIZE=10485760

# ============================================
# Facturación
# ============================================
INVOICE_UPLOAD_PATH=./invoices
INVOICE_COMPANY_NAME="Tu Empresa S.A."
INVOICE_COMPANY_NIT=123456789
INVOICE_COMPANY_ADDRESS="Calle Principal #123"
INVOICE_COMPANY_PHONE="+57 300 123 4567"
INVOICE_COMPANY_EMAIL=contacto@tuempresa.com
INVOICE_CURRENCY=COP
INVOICE_TAX_RATE=0.19
INVOICE_DEFAULT_DUE_DAYS=30
